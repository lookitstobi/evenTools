{
  "name": "Toolsapp",
  "postStartCommand": "bash -lc 'cd /workspaces/toolsapp && ./sync_pdf_templates.sh auto --quiet || true'",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Toolsapp",
      "onAutoForward": "openPreview",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": true,
        "remote.restoreForwardedPorts": true
      }
    }
  }
}
