{
  "name": "Toolsapp",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Toolsapp",
      "onAutoForward": "openPreview",
      "protocol": "http"
    }
  },
  "customizations": {
